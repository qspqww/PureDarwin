new file mode 100644
index 0000000..71c8510
--- /dev/null
+++ b/include/ramfb.h
@@ -0,0 +1,34 @@
+#ifndef RAMFB_H
+#define RAMFB_H
+
+#include "common.h"
+#include "boot.h"
+
+/* QEMU ramfb fallback framebuffer (aarch64/QEMU-virt only).
+ *
+ * When the firmware offers no usable GOP (e.g. EDK2 built without a display
+ * driver for the attached device, or a GOP with no linear modes), and the
+ * user passed "ramfb" (optionally "ramfb=WxH") on the kernel command line,
+ * drive QEMU's ramfb device directly through fw_cfg: allocate a reserved
+ * framebuffer, hand it to the host, and report it like a GOP mode so XNU
+ * publishes IOGOPFramebuffer and Xorg's puredarwingop driver attaches.
+ *
+ * Never touches hardware unless all three gates pass: the "ramfb" boot-arg,
+ * QEMU's ACPI OEM ID, and the fw_cfg signature. Any failure leaves
+ * out->found FALSE (headless), which is not an error.
+ */
+#if defined(__aarch64__)
+EFI_STATUS ramfb_fallback_video(AppContext *ctx, const CHAR8 *cmdline, boot_video_info *out);
+#else
+static inline EFI_STATUS
+ramfb_fallback_video(AppContext *ctx, const CHAR8 *cmdline, boot_video_info *out)
+{
+  (VOID)ctx;
+  (VOID)cmdline;
+  if (out)
+    out->found = FALSE;
+  return EFI_SUCCESS;
+}
+#endif
+
+#endif
